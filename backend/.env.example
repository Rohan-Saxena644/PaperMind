# App
APP_NAME=PaperMind
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# Database
DATABASE_URL=postgresql://papermind:papermind@postgres:5432/papermind

# Redis
REDIS_URL=redis://redis:6379/0

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=papermind_papers

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=papermind-neo4j

# Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AI_RPM_LIMIT=10
AI_DAILY_LIMIT=225
AI_MAX_PAPER_CHARS=14000
AI_MAX_CHAT_CONTEXT_CHARS=6000
AI_MAX_QUESTION_CHARS=1000

# Worker retries
WORKER_MAX_RETRIES=5
WORKER_RETRY_BASE_SECONDS=60
WORKER_RETRY_MAX_SECONDS=900

# Storage (local for dev, swap to S3 for prod)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/uploads

# Auth
ACCESS_TOKEN_EXPIRE_MINUTES=10080
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
